# Server
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# MongoDB Atlas connection string (must be an Atlas cluster to use Atlas Vector Search)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/contentiq?retryWrites=true&w=majority

# Auth
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=24h

# Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite
# Free tier can be as low as 5 requests/minute for generateContent — keep this
# conservatively below that. Raise it once you're on a paid tier with more quota.
GEMINI_GENERATION_RPM=4
EMBEDDING_MODEL=gemini-embedding-001
# Must match the numDimensions baked into the Atlas Vector Search index at creation time.
# Changing this after running db:setup-index requires recreating the index and re-embedding all chunks.
EMBEDDING_DIMENSIONS=768

# RAG / chunking tuning
CHUNK_SIZE=1200
CHUNK_OVERLAP=150
TOP_K=6
SIMILARITY_THRESHOLD=0.55
VECTOR_INDEX_NAME=vector_index

# File uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=50

# Rate limiting (expensive AI routes)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=20

# PDF visual analysis — Gemini describes charts/tables/figures and OCRs scanned pages
PDF_VISUAL_ANALYSIS=true

# Google sign-in (https://console.cloud.google.com/apis/credentials → OAuth client ID, type "Web application").
# Use the same client ID for VITE_GOOGLE_CLIENT_ID in the root .env. Leave empty to disable.
GOOGLE_CLIENT_ID=

# Password reset emails. If SMTP_HOST is empty, reset links are printed to the server console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=ContentIQ AI <no-reply@contentiq.local>
PASSWORD_RESET_TTL_MINUTES=60
